@page "/players"
@using NPNG.Domain.Services
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="app-header">
    <div class="header-nav">
        <BackButton />
        <span style="font-size:1.05rem;font-weight:700">@GameDisplayName — Joueurs</span>
    </div>
    <div class="header-count">@CurrentPlayerCount/@MaxPlayers</div>
</div>

<div class="section-label">Ordre et 1er joueur</div>

@if (GameState.CurrentSession == null || GameState.CurrentSession.Players.Length == 0)
{
    <div class="empty-state">
        Ajoute des joueurs pour commencer !
    </div>
}
else
{
    <div class="player-list">
        @{
            var playersList = GameState.CurrentSession.Players.OrderBy(p => p.DisplayOrder).ToList();
        }
        
        @for (int i = 0; i < playersList.Count; i++)
        {
            var player = playersList[i];
            var isFirstInList = i == 0;
            var isLastInList = i == playersList.Count - 1;

            <div class="player-row" @key="player.PlayerId">
                @if (TeamModeEnabled)
                {
                    @if (player.TeamId is { } playerTeamId)
                    {
                        <span class="player-team-tag" title="@TeamNameFormatter.GetDisplayName(playerTeamId, GameState.CurrentSession!.Teams, GameState.CurrentSession!.Players)">@TeamEmojiFormatter.GetDisplayEmoji(playerTeamId, GameState.CurrentSession!.Teams)</span>
                    }
                    else
                    {
                        <input type="checkbox" class="chk" checked="@selectedForTeam.Contains(player.PlayerId)" @onchange="() => ToggleSelectedForTeam(player.PlayerId)" />
                    }
                }
                <div class="player-order-controls">
                    <button class="ico-btn move-btn" disabled="@isFirstInList" @onclick="() => MovePlayerUp(player.PlayerId)">▲</button>
                    <button class="ico-btn move-btn" disabled="@isLastInList" @onclick="() => MovePlayerDown(player.PlayerId)">▼</button>
                </div>
                <EmojiAvatarPicker Categories="EmojiPalette.PlayerCategories" BorderColor="@player.Color"
                                    SelectedEmoji="@player.Emoji" SelectedEmojiChanged="@(e => UpdatePlayerEmoji(player.PlayerId, e))" />

                <div class="player-info">
                    <span class="player-name">@player.Name</span>
                    @if (player.IsFirstPlayer && GameState.CurrentSession?.Template.Rules != null && GameState.CurrentSession.Template.Rules.FirstPlayerMechanic != FirstPlayerMechanic.None)
                    {
                        <span class="first-player-badge">PREMIER JOUEUR</span>
                    }
                </div>

                @if (!player.IsFirstPlayer && GameState.CurrentSession?.Template.Rules != null && GameState.CurrentSession.Template.Rules.FirstPlayerMechanic != FirstPlayerMechanic.None)
                {
                    <button class="ico-btn action-btn"
                            title="Définir comme 1er joueur" @onclick="() => SetFirstPlayer(player.PlayerId)">🏁
                    </button>
                }
                
                <button class="ico-btn action-btn-fav @(IsFavorite(player.Name) ? "star-active" : "")"
                        title="@(IsFavorite(player.Name) ? "Retirer des favoris" : "Ajouter aux favoris")"
                        @onclick="() => ToggleFavorite(player.Name, player.Emoji)">
                    @(IsFavorite(player.Name) ? "★" : "☆")
                </button>

                <button class="btn-danger action-btn-del" @onclick="() => RemovePlayer(player.PlayerId)">
                    ✕
                </button>
            </div>
        }
    </div>
}

@if (TeamModeEnabled)
{
    @if (UnteamedPlayers.Any())
    {
        <button class="btn-cta team-create-btn" disabled="@(!CanCreateTeamFromSelection)" @onclick="CreateTeam">➕ Créer une équipe avec la sélection</button>
        @if (RequiredTeamSize is { } size)
        {
            <div class="team-size-hint">Équipes de @size joueur@(size > 1 ? "s" : "")</div>
        }
    }

    @if (Teams.Any())
    {
        <div class="section-label">Équipes</div>
        <div class="team-list">
            @foreach (var team in Teams)
            {
                <div class="team-card" @key="team.TeamId">
                    @if (editingTeamId == team.TeamId)
                    {
                        <div class="field-lbl">Nom de l'équipe</div>
                        <input class="field-input" type="text" @bind="editTeamName" @bind:event="oninput" />
                        <div class="team-edit-actions">
                            <button class="btn-cta" disabled="@string.IsNullOrWhiteSpace(editTeamName)" @onclick="SaveTeamName">✓ Enregistrer</button>
                            <button class="btn-secondary" @onclick="CancelEditTeamName">Annuler</button>
                        </div>
                    }
                    else
                    {
                        <div class="team-card-header">
                            <EmojiAvatarPicker Categories="EmojiPalette.GameCategories" Small="true"
                                                SelectedEmoji="@team.DisplayEmoji" SelectedEmojiChanged="@(e => UpdateTeamEmoji(team.TeamId, e))" />
                            <span class="team-card-name">@team.DisplayName</span>
                            @if (UnteamedPlayers.Any())
                            {
                                <button class="ico-btn" title="Ajouter la sélection à cette équipe"
                                        disabled="@(!CanAddSelectionToTeam(team))" @onclick="() => AddSelectionToTeam(team.TeamId)">➕</button>
                            }
                            <button class="ico-btn" title="Renommer" @onclick="() => StartEditTeamName(team.TeamId, team.DisplayName)">✎</button>
                            <button class="btn-danger" title="Supprimer l'équipe" @onclick="() => DeleteTeam(team.TeamId)">🗑</button>
                        </div>
                    }
                    <div class="team-members">
                        @foreach (var member in team.Members)
                        {
                            <span class="team-member-chip">
                                @member.Emoji @member.Name
                                <button class="team-member-remove-btn" title="Retirer de l'équipe" @onclick="() => RemovePlayerFromTeam(member.PlayerId)">✕</button>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@if (CurrentPlayerCount < MaxPlayers)
{
    <div class="section-label">Ajouter un joueur</div>
    <div class="add-player-row">
        <EmojiAvatarPicker Categories="EmojiPalette.PlayerCategories" BorderColor="@NextPlayerColor" @bind-SelectedEmoji="selectedEmoji" />
        <input class="add-input @(showDuplicateError ? "error" : "")" type="text" placeholder="Prénom…" @bind="newPlayerName" @bind:event="oninput"
               @onkeyup="HandleKeyUp"/>
        <button class="add-btn" @onclick="AddPlayer"
                disabled="@string.IsNullOrWhiteSpace(newPlayerName)">＋ Ajouter
        </button>
    </div>
    @if (showDuplicateError)
    {
        <div class="error-msg">Ce joueur est déjà dans la partie !</div>
    }
}

@if (favoritePlayers.Any())
{
    <div class="section-label">Favoris</div>
    <div class="fav-list">
        @foreach (var fav in favoritePlayers)
        {
            var isAlreadyInGame = GameState.CurrentSession?.Players.Any(p => p.Name.Equals(fav.Name, StringComparison.OrdinalIgnoreCase)) == true;
            <div class="fav-item-container">
                <button class="fav-chip" 
                        @onclick="() => AddFavoritePlayerToGame(fav)" disabled="@(isAlreadyInGame || CurrentPlayerCount >= MaxPlayers)">
                    <span class="fav-emoji">@fav.DefaultEmoji</span>
                    <span>@fav.Name</span>
                </button>
                <button class="ico-btn fav-del-btn"
                        @onclick="() => RemoveFavoritePlayer(fav.Id)"
                        title="Supprimer des favoris">✕</button>
            </div>
        }
    </div>
}

<button class="btn-cta" disabled="@StartDisabled" @onclick="StartGame">
    Lancer la partie ▶
</button>

@code {
    [Inject] public GameStateService GameState { get; set; } = default!;
    [Inject] public IPlayerProfileRepository ProfileRepository { get; set; } = default!;

    private string GameDisplayName => GameState.CurrentSession?.Template.Name ?? "Partie";

    private string newPlayerName = "";
    private string selectedEmoji = "🎯";
    
    private List<Player> favoritePlayers = new();

    private List<string> availableColors = new() { "#7C9EBF", "#4ADE80", "var(--accent)", "#F87171", "#A78BFA", "#FCD34D", "#60A5FA", "#F472B6" };

    private const int DefaultMaxPlayers = 8;
    private const int DefaultMinPlayers = 2;
    private const int MinTeamsRequired = 2;

    private int CurrentPlayerCount => GameState.CurrentSession?.Players.Length ?? 0;
    private int MaxPlayers => GameState.CurrentSession?.Template.Rules?.MaxPlayers ?? DefaultMaxPlayers;
    private int MinPlayers => GameState.CurrentSession?.Template.Rules?.MinPlayers ?? DefaultMinPlayers;
    private string NextPlayerColor => availableColors[CurrentPlayerCount % availableColors.Count];

    // MinPlayers décrit toujours le nombre de joueurs physiques, peu importe le mode.
    // En mode équipe, on exige en plus qu'au moins 2 équipes soient formées (une seule équipe n'a pas de sens)
    // et que la composition respecte la config du jeu (taille fixe et/ou équipes égales).
    private bool StartDisabled => CurrentPlayerCount < MinPlayers
        || (TeamModeEnabled && (UnteamedPlayers.Any() || Teams.Count < MinTeamsRequired || !TeamSizesValid));

    private record TeamViewModel(Guid TeamId, string DisplayName, string DisplayEmoji, List<SessionPlayer> Members);

    private readonly HashSet<Guid> selectedForTeam = new();
    private Guid? editingTeamId;
    private string editTeamName = "";

    // Le mode équipe est entièrement piloté par la config du jeu — plus de bascule manuelle
    // pour ne pas avoir à gérer un état "équipes formées mais mode désactivé".
    private TeamRules? TeamConfig => GameState.CurrentSession?.Template.ScoreType != ScoreType.Structured
        ? GameState.CurrentSession?.Template.Rules?.Teams
        : null;

    private bool TeamModeEnabled => TeamConfig is not null;
    private int? RequiredTeamSize => TeamConfig?.TeamSize;

    private bool TeamSizesValid
    {
        get
        {
            if (TeamConfig is not { RequiresEqualSizes: true } config) return true;
            if (config.TeamSize is { } size) return Teams.All(t => t.Members.Count == size);
            return Teams.Select(t => t.Members.Count).Distinct().Count() <= 1;
        }
    }

    private bool CanCreateTeamFromSelection =>
        selectedForTeam.Any() && (RequiredTeamSize is not { } size || selectedForTeam.Count == size);

    private bool CanAddSelectionToTeam(TeamViewModel team) =>
        selectedForTeam.Any() && (RequiredTeamSize is not { } size || team.Members.Count + selectedForTeam.Count <= size);

    private List<TeamViewModel> Teams =>
        GameState.CurrentSession?.Players
            .Where(p => p.TeamId is not null)
            .GroupBy(p => p.TeamId!.Value)
            .Select(g => new TeamViewModel(
                g.Key,
                TeamNameFormatter.GetDisplayName(g.Key, GameState.CurrentSession.Teams, GameState.CurrentSession.Players),
                TeamEmojiFormatter.GetDisplayEmoji(g.Key, GameState.CurrentSession.Teams),
                g.OrderBy(p => p.DisplayOrder).ToList()))
            .ToList()
        ?? new List<TeamViewModel>();

    private List<SessionPlayer> UnteamedPlayers =>
        GameState.CurrentSession?.Players.Where(p => p.TeamId is null).OrderBy(p => p.DisplayOrder).ToList()
        ?? new List<SessionPlayer>();

    protected override async Task OnInitializedAsync()
    {
        GameState.OnStateChanged += StateHasChanged;

        // Si la session est nulle (par exemple après un F5), on essaie de la recharger depuis le LocalStorage
        if (GameState.CurrentSession == null)
        {
            var loaded = await GameState.LoadLatestActiveSessionAsync();
            if (!loaded)
            {
                // Si aucune session n'a pu être restaurée, on retourne à l'accueil
                NavigationManager.NavigateTo("");
                return;
            }
        }

        // Une fois la partie réellement démarrée, cet écran devient inaccessible (bouton retour,
        // carte "reprendre" de l'accueil, URL directe) pour éviter de décaler des scores déjà saisis.
        if (GameState.CurrentSession!.HasProgress)
        {
            NavigationManager.NavigateTo("session", replace: true);
            return;
        }

        await LoadFavoritesAsync();
    }
    
    private async Task LoadFavoritesAsync()
    {
        var favs = await ProfileRepository.GetFavoritePlayersAsync();
        favoritePlayers = favs.ToList();
    }
    
    private bool IsFavorite(string name)
    {
        return favoritePlayers.Any(f => f.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
    }
    
    private async Task ToggleFavorite(string name, string emoji)
    {
        var existingFav = favoritePlayers.FirstOrDefault(f => f.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
        if (existingFav != null)
        {
            await ProfileRepository.RemoveFavoritePlayerAsync(existingFav.Id);
        }
        else
        {
            await ProfileRepository.AddFavoritePlayerAsync(new Player(Guid.NewGuid(), name, emoji));
        }
        
        await LoadFavoritesAsync();
    }
    
    private async Task AddFavoritePlayerToGame(Player fav)
    {
        if (CurrentPlayerCount >= MaxPlayers) return;
        await GameState.AddPlayerToSetupAsync(fav.Name, fav.DefaultEmoji, NextPlayerColor);
    }

    private async Task RemoveFavoritePlayer(Guid favId)
    {
        await ProfileRepository.RemoveFavoritePlayerAsync(favId);
        await LoadFavoritesAsync();
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= StateHasChanged;
    }

    private bool showDuplicateError = false;

    private async Task AddPlayer()
    {
        if (string.IsNullOrWhiteSpace(newPlayerName) || CurrentPlayerCount >= MaxPlayers) return;

        var nameToAdding = newPlayerName.Trim();
        
        if (GameState.CurrentSession?.Players.Any(p => p.Name.Equals(nameToAdding, StringComparison.OrdinalIgnoreCase)) == true)
        {
            showDuplicateError = true;
            return;
        }

        var isFirstPlayerAdded = CurrentPlayerCount == 0;

        await GameState.AddPlayerToSetupAsync(nameToAdding, selectedEmoji, NextPlayerColor);

        if (isFirstPlayerAdded)
        {
            await ProfileRepository.AddFavoritePlayerAsync(new Player(Guid.NewGuid(), nameToAdding, selectedEmoji));
            await LoadFavoritesAsync();
        }

        newPlayerName = "";
        showDuplicateError = false;

        var allEmojis = EmojiPalette.PlayerCategories.SelectMany(c => c.Emojis).ToList();
        selectedEmoji = allEmojis[Random.Shared.Next(allEmojis.Count)];
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        showDuplicateError = false; // Reset error on any typing
        if (e.Key == "Enter")
        {
            await AddPlayer();
        }
    }

    private async Task RemovePlayer(Guid playerId)
    {
        await GameState.RemovePlayerFromSetupAsync(playerId);
    }

    private async Task UpdatePlayerEmoji(Guid playerId, string emoji)
    {
        await GameState.UpdatePlayerEmojiAsync(playerId, emoji);
    }

    private async Task UpdateTeamEmoji(Guid teamId, string emoji)
    {
        await GameState.UpdateTeamEmojiAsync(teamId, emoji);
    }

    private async Task SetFirstPlayer(Guid playerId)
    {
        await GameState.SetFirstPlayerManuallyAsync(playerId);
    }

    private async Task MovePlayerUp(Guid playerId)
    {
        await GameState.MovePlayerUpAsync(playerId);
    }

    private async Task MovePlayerDown(Guid playerId)
    {
        await GameState.MovePlayerDownAsync(playerId);
    }

    private async Task StartGame()
    {
        await GameState.StartSessionAsync();
        NavigationManager.NavigateTo("session");
    }

    private void ToggleSelectedForTeam(Guid playerId)
    {
        if (!selectedForTeam.Add(playerId))
        {
            selectedForTeam.Remove(playerId);
        }
    }

    private async Task CreateTeam()
    {
        if (!CanCreateTeamFromSelection) return;

        await GameState.CreateTeamAsync(selectedForTeam);
        selectedForTeam.Clear();
    }

    private async Task AddSelectionToTeam(Guid teamId)
    {
        var team = Teams.FirstOrDefault(t => t.TeamId == teamId);
        if (team is null || !CanAddSelectionToTeam(team)) return;

        await GameState.AddPlayersToTeamAsync(teamId, selectedForTeam);
        selectedForTeam.Clear();
    }

    private void StartEditTeamName(Guid teamId, string currentName)
    {
        editingTeamId = teamId;
        editTeamName = currentName;
    }

    private void CancelEditTeamName()
    {
        editingTeamId = null;
    }

    private async Task SaveTeamName()
    {
        if (editingTeamId is null || string.IsNullOrWhiteSpace(editTeamName)) return;

        await GameState.RenameTeamAsync(editingTeamId.Value, editTeamName.Trim());
        editingTeamId = null;
    }

    private async Task DeleteTeam(Guid teamId)
    {
        await GameState.DeleteTeamAsync(teamId);
    }

    private async Task RemovePlayerFromTeam(Guid playerId)
    {
        await GameState.RemovePlayerFromTeamAsync(playerId);
    }

}
