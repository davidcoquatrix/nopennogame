@page "/session/history"
@using NPNG.Domain.Entities
@using NPNG.Domain.Models
@using NPNG.Domain.Services
@using System.Linq
@inject GameStateService GameState

<div class="app-header">
    <div class="header-nav">
        <BackButton />
        <span class="header-title">@(GameState.CurrentSession?.Template.Name ?? "Historique")</span>
    </div>
    <div class="header-subtitle">⏪ Mode édition</div>
</div>

@if (GameState.CurrentSession != null && GameState.CurrentSession.Template.ScoreType == ScoreType.Structured)
{
    <div class="section-label">Feuille de score</div>
    <StructuredScoreSheet
        Definition="StructuredScoringCatalogue.Get(GameState.CurrentSession.Template.StructuredKind!.Value)"
        Players="GameState.CurrentSession.Players"
        ExistingScores="GameState.CurrentSession.Scores"
        OnSubmit="HandleStructuredEdit" />
}
else if (GameState.CurrentSession == null || maxCompletedRound < 1)
{
    <div class="empty-state">
        <div class="empty-icon">⏳</div>
        <div class="empty-text">Aucun tour terminé à modifier pour le moment.</div>
        <button class="primary-btn mt-15" @onclick="GoBack">Retour</button>
    </div>
}
else
{
    <!-- warning banner -->
    <div class="tt-banner">
        <span class="ico">⚠️</span>
        <span class="txt">Mode Time Travel — Modification d'un tour passé. Le classement sera recalculé.</span>
    </div>

    <!-- tour nav -->
    <div class="section-label">Sélectionner un tour</div>
    <div class="tt-nav">
        @for (int i = 1; i <= maxCompletedRound; i++)
        {
            var roundNum = i;
            var isCurrent = roundNum == editingRound;
            
            <div class="tt-btn @(isCurrent ? "cur" : "")" @onclick="() => SelectRound(roundNum)">
                T.@roundNum
            </div>
        }
    </div>

    <!-- editable score grid -->
    <div class="section-label">Scores — Tour @editingRound</div>
    <div class="table-container">
        <table class="round-table editing-mode">
            <thead>
                <tr>
                    <th>@(IsTeamMode ? "Équipe" : "Joueur")</th>
                    @for (int i = 1; i <= maxCompletedRound; i++)
                    {
                        if (i == editingRound)
                        {
                            <th class="editing-col-header">T.@i ✎</th>
                        }
                        else
                        {
                            <th>T.@i</th>
                        }
                    }
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (IsTeamMode)
                {
                    @foreach (var teamId in TeamOrder)
                    {
                        var teamName = TeamNameFormatter.GetDisplayName(teamId, GameState.CurrentSession.Teams, GameState.CurrentSession.Players);
                        var teamEmoji = TeamEmojiFormatter.GetDisplayEmoji(teamId, GameState.CurrentSession.Teams);
                        var representativePlayerId = GameState.CurrentSession.Players.First(p => p.TeamId == teamId).PlayerId;
                        var isLeader = teamLeaderboard.FirstOrDefault()?.TeamId == teamId;
                        var members = GameState.CurrentSession.Players.Where(p => p.TeamId == teamId).OrderBy(p => p.DisplayOrder);

                        <tr>
                            <td>
                                <div class="team-row-name">@teamEmoji @teamName</div>
                                <div class="team-row-members">@string.Join(" · ", members.Select(m => $"{m.Emoji} {m.Name}"))</div>
                            </td>
                            @for (int i = 1; i <= maxCompletedRound; i++)
                            {
                                if (i == editingRound)
                                {
                                    <td class="editable-col">
                                        <span class="score-value score-value-warn">@(tempScores.GetValueOrDefault(representativePlayerId, 0))</span>
                                    </td>
                                }
                                else
                                {
                                    <td>@(GetScoreForRound(representativePlayerId, i))</td>
                                }
                            }
                            <td class="total-cell @(isLeader ? "lead" : "")">
                                @GetProjectedTotalScore(representativePlayerId)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    @foreach (var player in GameState.CurrentSession.Players.OrderBy(p => p.DisplayOrder))
                    {
                        var isLeader = leaderboard.FirstOrDefault()?.PlayerId == player.PlayerId;

                        <tr>
                            <td>@player.Emoji @player.Name</td>
                            @for (int i = 1; i <= maxCompletedRound; i++)
                            {
                                if (i == editingRound)
                                {
                                    <td class="editable-col">
                                        <span class="score-value score-value-warn">@(tempScores.GetValueOrDefault(player.PlayerId, 0))</span>
                                    </td>
                                }
                                else
                                {
                                    <td>@(GetScoreForRound(player.PlayerId, i))</td>
                                }
                            }
                            <td class="total-cell @(isLeader ? "lead" : "")">
                                @GetProjectedTotalScore(player.PlayerId)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- correction in progress -->
    <div class="entry-panel">
        <div class="entry-panel-label">Correction — Tour @editingRound</div>

        @if (IsTeamMode)
        {
            @foreach (var teamId in TeamOrder)
            {
                var teamName = TeamNameFormatter.GetDisplayName(teamId, GameState.CurrentSession.Teams, GameState.CurrentSession.Players);
                var teamEmoji = TeamEmojiFormatter.GetDisplayEmoji(teamId, GameState.CurrentSession.Teams);
                var representativePlayerId = GameState.CurrentSession.Players.First(p => p.TeamId == teamId).PlayerId;

                <div class="entry-row">
                    <div class="entry-avatar">@teamEmoji</div>
                    <span class="entry-name">@teamName</span>
                    <ScoreInput
                        InputClass="score-value-warn"
                        Value="@(tempScores.GetValueOrDefault(representativePlayerId, 0))"
                        Mode="@ScoreIncrement"
                        OnScoreAdjusted="@((int amount) => AdjustTeamEditScore(teamId, amount))"
                        OnValueChanged="@((int val) => OnTeamScoreInputChange(teamId, new ChangeEventArgs { Value = val }))" />
                </div>
            }
        }
        else
        {
            @foreach (var player in GameState.CurrentSession.Players.OrderBy(p => p.DisplayOrder))
            {
                <div class="entry-row">
                    <div class="entry-avatar">@player.Emoji</div>
                    @if (IsPhaseProgression)
                    {
                        var phaseNumber = tempPhaseNumbers.GetValueOrDefault(player.PlayerId, 1);
                        <div class="entry-info">
                            <span class="entry-name entry-name-override">@player.Name</span>
                            <PhaseScoreInput
                                CurrentPhase="phaseNumber"
                                PhaseDescription="@Phase10Phases.Descriptions[phaseNumber - 1]"
                                Completed="@tempPhaseCompleted.GetValueOrDefault(player.PlayerId)"
                                OnCompletedChanged="@((bool c) => OnPhaseCompletedChanged(player.PlayerId, c))" />
                        </div>
                    }
                    else
                    {
                        <span class="entry-name">@player.Name</span>
                    }
                    <ScoreInput
                        InputClass="score-value-warn"
                        Value="@(tempScores.GetValueOrDefault(player.PlayerId, 0))"
                        Mode="@ScoreIncrement"
                        OnScoreAdjusted="@((int amount) => AdjustEditScore(player.PlayerId, amount))"
                        OnValueChanged="@((int val) => OnScoreInputChange(player.PlayerId, new ChangeEventArgs { Value = val }))" />
                </div>
            }
        }

        <button class="validate-btn mt-15" @onclick="ConfirmEdit">✓ Confirmer le Tour @editingRound</button>
    </div>
}

@code {
    [Inject] public NavigationHistoryTracker NavigationHistory { get; set; } = default!;

    private int maxCompletedRound = 0;
    private int editingRound = 1;
    private Dictionary<Guid, int> tempScores = new();
    private Dictionary<Guid, int> tempPhaseNumbers = new();
    private Dictionary<Guid, bool> tempPhaseCompleted = new();
    private List<PlayerScore> leaderboard = new();
    private List<TeamScore> teamLeaderboard = new();

    private bool IsTeamMode => GameState.CurrentSession?.Players.Any(p => p.TeamId is not null) == true;

    private bool IsPhaseProgression => GameState.CurrentSession?.Template.ScoreType == ScoreType.PhaseProgression;

    private ScoreIncrementMode ScoreIncrement => GameState.CurrentSession?.Template.Rules?.ScoreIncrement ?? ScoreIncrementMode.OneAndTen;

    private IEnumerable<Guid> TeamOrder =>
        GameState.CurrentSession?.Players
            .Where(p => p.TeamId is not null)
            .GroupBy(p => p.TeamId!.Value)
            .OrderBy(g => g.Min(p => p.DisplayOrder))
            .Select(g => g.Key)
        ?? Enumerable.Empty<Guid>();

    protected override void OnInitialized()
    {
        if (GameState.CurrentSession == null) return;
        if (GameState.CurrentSession.Template.ScoreType == ScoreType.Structured) return;

        maxCompletedRound = GameState.CurrentSession.Status == SessionStatus.Finished
            ? GameState.CurrentSession.CurrentRound
            : GameState.CurrentSession.CurrentRound - 1;

        if (maxCompletedRound > 0)
        {
            editingRound = maxCompletedRound; // Default to most recently completed round
            LoadRoundToEdit(editingRound);
            CalculateCurrentLeaderboard();
        }
    }

    private void SelectRound(int round)
    {
        editingRound = round;
        LoadRoundToEdit(round);
        CalculateCurrentLeaderboard(); // Needed to reflect the change in selected round correctly
    }

    private async Task GoBack()
    {
        await NavigationHistory.GoBackOrHomeAsync();
    }

    private void LoadRoundToEdit(int round)
    {
        tempScores.Clear();
        tempPhaseNumbers.Clear();
        tempPhaseCompleted.Clear();
        if (GameState.CurrentSession != null)
        {
            foreach (var player in GameState.CurrentSession.Players)
            {
                var entry = GameState.CurrentSession.Scores.FirstOrDefault(s => s.PlayerId == player.PlayerId && s.Round == round);
                tempScores[player.PlayerId] = entry?.Value ?? 0;
                tempPhaseNumbers[player.PlayerId] = entry?.PhaseDetail?.PhaseNumber ?? 1;
                tempPhaseCompleted[player.PlayerId] = entry?.PhaseDetail?.Completed ?? false;
            }
        }
    }

    private void OnPhaseCompletedChanged(Guid playerId, bool completed)
    {
        tempPhaseCompleted[playerId] = completed;
        CalculateCurrentLeaderboard();
    }

    private void AdjustEditScore(Guid playerId, int amount)
    {
        if (tempScores.ContainsKey(playerId))
        {
            tempScores[playerId] += amount;
            CalculateCurrentLeaderboard(); // Recalculate leaderboard on every change for dynamic total preview
        }
    }

    private int GetScoreForRound(Guid playerId, int round)
    {
        if (GameState.CurrentSession == null) return 0;
        var entry = GameState.CurrentSession.Scores.FirstOrDefault(s => s.PlayerId == playerId && s.Round == round);
        return entry?.Value ?? 0;
    }

    private int GetProjectedTotalScore(Guid playerId)
    {
        if (GameState.CurrentSession == null) return 0;
        
        var actualScoresSum = GameState.CurrentSession.Scores
            .Where(s => s.PlayerId == playerId && s.Round <= maxCompletedRound && s.Round != editingRound)
            .Sum(s => s.Value);

        var editedScore = tempScores.GetValueOrDefault(playerId, 0);

        return actualScoresSum + editedScore;
    }

    private void CalculateCurrentLeaderboard()
    {
        if (GameState.CurrentSession == null) return;

        var playerIds = GameState.CurrentSession.Players.Select(p => p.PlayerId).ToList();

        var projectedScores = GameState.CurrentSession.Scores
            .Where(s => s.Round <= maxCompletedRound && s.Round != editingRound)
            .ToList();

        foreach (var kvp in tempScores)
        {
            var phaseDetail = IsPhaseProgression
                ? new PhaseScoreDetail(tempPhaseNumbers.GetValueOrDefault(kvp.Key, 1), tempPhaseCompleted.GetValueOrDefault(kvp.Key))
                : null;
            projectedScores.Add(new ScoreEntry(Guid.NewGuid(), GameState.CurrentSession.Id, kvp.Key, editingRound, kvp.Value, PhaseDetail: phaseDetail));
        }

        var computed = ScoreCalculator.CalculateLeaderboard(
            GameState.CurrentSession.Template.ScoreType,
            playerIds,
            projectedScores
        );
        leaderboard = computed.ToList();

        teamLeaderboard = IsTeamMode
            ? ScoreCalculator.GroupIntoTeams(computed, GameState.CurrentSession.Players, GameState.CurrentSession.Teams).ToList()
            : new List<TeamScore>();
    }

    private void AdjustTeamEditScore(Guid teamId, int amount)
    {
        if (GameState.CurrentSession == null) return;

        var memberIds = GameState.CurrentSession.Players.Where(p => p.TeamId == teamId).Select(p => p.PlayerId);
        foreach (var playerId in memberIds)
        {
            if (tempScores.ContainsKey(playerId))
            {
                tempScores[playerId] += amount;
            }
        }

        CalculateCurrentLeaderboard();
    }

    private void OnTeamScoreInputChange(Guid teamId, ChangeEventArgs e)
    {
        if (GameState.CurrentSession == null) return;
        if (!int.TryParse(e.Value?.ToString(), out var result)) return;

        var memberIds = GameState.CurrentSession.Players.Where(p => p.TeamId == teamId).Select(p => p.PlayerId);
        foreach (var playerId in memberIds)
        {
            tempScores[playerId] = result;
        }

        CalculateCurrentLeaderboard();
    }

    private void OnScoreInputChange(Guid playerId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var result))
        {
            tempScores[playerId] = result;
            CalculateCurrentLeaderboard();
        }
    }

    private async Task ConfirmEdit()
    {
        if (GameState.CurrentSession != null)
        {
            foreach (var kvp in tempScores)
            {
                if (IsPhaseProgression)
                {
                    var phaseDetail = new PhaseScoreDetail(tempPhaseNumbers.GetValueOrDefault(kvp.Key, 1), tempPhaseCompleted.GetValueOrDefault(kvp.Key));
                    await GameState.RecordScoreAsync(kvp.Key, editingRound, kvp.Value, phaseDetail);
                }
                else
                {
                    await GameState.RecordScoreAsync(kvp.Key, editingRound, kvp.Value);
                }
            }
        }
        await GoBack();
    }

    private async Task HandleStructuredEdit(IReadOnlyDictionary<Guid, StructuredScoreDetail> details)
    {
        // La session est Finished ici : ResumeSessionAsync la repasse Active sans toucher CurrentRound
        // pour les jeux Structured, ce qui permet à SubmitStructuredScoreAndFinishAsync d'utiliser le round fixe.
        await GameState.ResumeSessionAsync();
        await GameState.SubmitStructuredScoreAndFinishAsync(details);
        await GoBack();
    }
}