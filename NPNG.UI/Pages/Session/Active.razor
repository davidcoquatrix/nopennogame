@page "/session"
@using NPNG.Domain.Services
@using NPNG.Domain.Models
@inject NavigationManager NavigationManager
@inject GameStateService GameState
@inject IJSRuntime JsRuntime
@implements IDisposable

@if (GameState.CurrentSession == null)
{
    <div class="no-session">Aucune session en cours...</div>
}
else if (GameState.CurrentSession.Status == SessionStatus.Finished)
{
    <div class="app-header">
        <div class="header-nav">
            @if (ShowBackButton)
            {
                <BackButton />
            }
            <span class="header-title">@GameState.CurrentSession.Template.Name</span>
        </div>
    </div>

    <GameRecapPanel Session="GameState.CurrentSession" />

    <button class="btn-cta mt-20" @onclick="GoToHome">Retour à l'accueil</button>
    @if (GameState.CurrentSession.Template.ScoreType == ScoreType.Structured)
    {
        <button class="btn-secondary" @onclick="GoToTimeTravel">✎ Modifier le score</button>
    }
    else
    {
        <button class="btn-secondary" @onclick="ResumeSession">Continuer la partie quand même</button>
    }
}
else if (GameState.CurrentSession.Template.ScoreType == ScoreType.Structured)
{
    <div class="app-header">
        <div class="header-nav">
            @if (ShowBackButton)
            {
                <BackButton />
            }
            <span class="header-title">@GameState.CurrentSession.Template.Name</span>
        </div>
    </div>

    <div class="section-label">Feuille de score</div>
    <AkropolisScoreSheet
        Players="GameState.CurrentSession.Players"
        ExistingScores="GameState.CurrentSession.Scores"
        OnSubmit="HandleStructuredSubmit" />
}
else
{
    <div class="app-header">
        <div class="header-nav">
            @if (ShowBackButton)
            {
                <BackButton />
            }
            <span class="header-title">@GameState.CurrentSession.Template.Name</span>
        </div>
        <div class="header-actions">
            <span class="header-round-counter">T.@(GameState.CurrentSession.CurrentRound.ToString("D2"))</span>
            <button class="ico-btn tt-btn" title="Time Travel" @onclick="GoToTimeTravel">⏪</button>
            <button class="ico-btn finish-btn" title="Terminer" @onclick="FinishSession">🏁</button>
        </div>
    </div>

    <!-- LIVE LEADERBOARD -->
    <div class="section-label">Classement</div>
    <div class="leaderboard">
        @if (IsTeamMode)
        {
            @foreach (var tScore in teamLeaderboard)
            {
                var isLeader = tScore.Rank == 1;
                var members = GameState.CurrentSession.Players
                    .Where(p => tScore.MemberPlayerIds.Contains(p.PlayerId))
                    .OrderBy(p => p.DisplayOrder);

                <div class="leaderboard-row @(isLeader ? "lead" : "")">
                    <span class="rank">@tScore.Rank</span>
                    <div class="av-m">🤝</div>
                    <div class="leaderboard-info">
                        <div class="leaderboard-name">@tScore.DisplayName</div>
                        <div class="pips">
                            @foreach (var member in members)
                            {
                                <span class="pip">@member.Emoji @member.Name</span>
                            }
                        </div>
                    </div>

                    @if (isLeader)
                    {
                        <span class="db best">meilleur</span>
                    }
                    else
                    {
                        var bestScore = teamLeaderboard.First().TotalScore;
                        var diff = tScore.TotalScore - bestScore;
                        <span class="db pos">@(diff > 0 ? "+" : "")@diff</span>
                    }

                    <div class="tot">@tScore.TotalScore</div>
                </div>
            }
        }
        else
        {
            @foreach (var pScore in leaderboard)
            {
                var player = GameState.CurrentSession.Players.First(p => p.PlayerId == pScore.PlayerId);
                var isLeader = pScore.Rank == 1;

                <div class="leaderboard-row @(isLeader ? "lead" : "")">
                    <span class="rank">@pScore.Rank</span>
                    <div class="av-m">@player.Emoji</div>
                    <div class="leaderboard-info">
                        <div class="leaderboard-name">@player.Name</div>
                        <div class="pips">
                            @{
                                var playerScores = GameState.CurrentSession.Scores.Where(s => s.PlayerId == player.PlayerId).OrderBy(s => s.Round);
                                foreach (var score in playerScores)
                                {
                                    <span class="pip">@(score.Value > 0 ? "+" : "")@score.Value</span>
                                }
                            }
                        </div>
                    </div>

                    @if (isLeader)
                    {
                        <span class="db best">meilleur</span>
                    }
                    else
                    {
                        var bestScore = leaderboard.First().TotalScore;
                        var diff = pScore.TotalScore - bestScore;
                        <span class="db pos">@(diff > 0 ? "+" : "")@diff</span>
                    }

                    <div class="tot">@pScore.TotalScore</div>
                </div>
            }
        }
    </div>

    <!-- ENTRY PANEL -->
    <div class="section-label">Saisie — Tour @GameState.CurrentSession.CurrentRound</div>
    <div class="entry-panel">
        @if (IsTeamMode)
        {
            @foreach (var teamId in TeamEntryOrder)
            {
                var teamName = TeamNameFormatter.GetDisplayName(teamId, GameState.CurrentSession.Players);
                var members = GameState.CurrentSession.Players.Where(p => p.TeamId == teamId).OrderBy(p => p.DisplayOrder);

                <div class="entry-row">
                    <div class="entry-avatar">🤝</div>
                    <div class="entry-info">
                        <span class="entry-name entry-name-override">@teamName</span>
                        <span class="entry-team-members">@string.Join(" · ", members.Select(m => $"{m.Emoji} {m.Name}"))</span>
                    </div>
                    <ScoreInput
                        Value="@(currentTeamInputs.ContainsKey(teamId) ? currentTeamInputs[teamId] : 0)"
                        OnScoreAdjusted="@((int amount) => AdjustTeamScore(teamId, amount))"
                        OnValueChanged="@((int val) => OnTeamScoreInputChange(teamId, new ChangeEventArgs { Value = val }))" />
                </div>
            }
        }
        else
        {
            @foreach (var player in GameState.CurrentSession.Players.OrderBy(p => p.DisplayOrder))
            {
                var hasMechanic = GameState.CurrentSession.Template?.Rules != null
                                      && GameState.CurrentSession.Template.Rules.FirstPlayerMechanic != FirstPlayerMechanic.None;
                var showFirstPlayerBadge = player.IsFirstPlayer && hasMechanic;

                <div class="entry-row">
                    <div class="entry-avatar">@player.Emoji</div>
                    <div class="entry-info">
                        <span class="entry-name entry-name-override">@player.Name</span>
                        @if (showFirstPlayerBadge)
                        {
                            <span class="first-player-badge">1ER JOUEUR</span>
                        }
                    </div>
                    <ScoreInput
                        Value="@(currentInputs.ContainsKey(player.PlayerId) ? currentInputs[player.PlayerId] : 0)"
                        OnScoreAdjusted="@((int amount) => AdjustScore(player.PlayerId, amount))"
                        OnValueChanged="@((int val) => OnScoreInputChange(player.PlayerId, new ChangeEventArgs { Value = val }))" />
                </div>
            }
        }

        <button class="validate-btn" @onclick="ValidateRound">✓ &nbsp;Valider le
            tour @GameState.CurrentSession.CurrentRound</button>
    </div>
}

@code {
    private Dictionary<Guid, int> currentInputs = new();
    private List<PlayerScore> leaderboard = new();

    private Dictionary<Guid, int> currentTeamInputs = new();
    private List<TeamScore> teamLeaderboard = new();

    private bool IsTeamMode => GameState.CurrentSession?.Players.Any(p => p.TeamId.HasValue) == true;

    // Une fois la partie démarrée, il n'y a plus d'écran valide vers lequel revenir
    // (l'écran joueurs se verrouille dès qu'un score existe) — on masque donc le bouton retour.
    private bool ShowBackButton => GameState.CurrentSession != null && !GameState.CurrentSession.HasProgress;

    private IEnumerable<Guid> TeamEntryOrder =>
        GameState.CurrentSession?.Players
            .Where(p => p.TeamId.HasValue)
            .GroupBy(p => p.TeamId!.Value)
            .OrderBy(g => g.Min(p => p.DisplayOrder))
            .Select(g => g.Key)
        ?? Enumerable.Empty<Guid>();

    protected override async Task OnInitializedAsync()
    {
        GameState.OnStateChanged += HandleStateChanged;

        if (GameState.CurrentSession == null)
        {
            var loaded = await GameState.LoadLatestActiveSessionAsync();
            if (!loaded)
            {
                NavigationManager.NavigateTo("");
                return;
            }
        }

        UpdateState();
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        UpdateState();
        StateHasChanged();
    }

    private void UpdateState()
    {
        if (GameState.CurrentSession != null)
        {
            var playerIds = GameState.CurrentSession.Players.Select(p => p.PlayerId);
            var computedLeaderboard = ScoreCalculator.CalculateLeaderboard(
                GameState.CurrentSession.Template.ScoreType,
                playerIds,
                GameState.CurrentSession.Scores);
            leaderboard = computedLeaderboard.ToList();

            // S'assurer que chaque joueur a une entrée initialisée pour le tour en cours
            foreach (var p in GameState.CurrentSession.Players)
            {
                if (!currentInputs.ContainsKey(p.PlayerId))
                {
                    currentInputs[p.PlayerId] = 0;
                }
            }

            if (IsTeamMode)
            {
                teamLeaderboard = ScoreCalculator.GroupIntoTeams(computedLeaderboard, GameState.CurrentSession.Players).ToList();

                // S'assurer que chaque équipe a une entrée initialisée pour le tour en cours
                foreach (var teamId in TeamEntryOrder)
                {
                    if (!currentTeamInputs.ContainsKey(teamId))
                    {
                        currentTeamInputs[teamId] = 0;
                    }
                }
            }
        }
    }

    private void GoToHome()
    {
        NavigationManager.NavigateTo("");
    }

    private void GoToTimeTravel()
    {
        NavigationManager.NavigateTo("session/history");
    }

    private void AdjustScore(Guid playerId, int amount)
    {
        if (currentInputs.ContainsKey(playerId))
        {
            currentInputs[playerId] += amount;
        }
    }

    private void OnScoreInputChange(Guid playerId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var result))
        {
            currentInputs[playerId] = result;
        }
    }

    private void AdjustTeamScore(Guid teamId, int amount)
    {
        if (currentTeamInputs.ContainsKey(teamId))
        {
            currentTeamInputs[teamId] += amount;
        }
    }

    private void OnTeamScoreInputChange(Guid teamId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var result))
        {
            currentTeamInputs[teamId] = result;
        }
    }

    private async Task ValidateRound()
    {
        if (GameState.CurrentSession == null) return;

        int currentRound = GameState.CurrentSession.CurrentRound;

        if (IsTeamMode)
        {
            foreach (var input in currentTeamInputs)
            {
                await GameState.RecordTeamScoreAsync(input.Key, currentRound, input.Value);
            }

            foreach (var key in currentTeamInputs.Keys.ToList())
            {
                currentTeamInputs[key] = 0;
            }
        }
        else
        {
            // On enregistre tous les scores saisis
            foreach (var input in currentInputs)
            {
                await GameState.RecordScoreAsync(input.Key, currentRound, input.Value);
            }

            // On remet les compteurs à 0 pour le prochain tour
            foreach (var key in currentInputs.Keys.ToList())
            {
                currentInputs[key] = 0;
            }
        }

        // On passe au tour suivant (ce qui mettra à jour le 1er joueur)
        await GameState.AdvanceToNextRoundAsync();
    }

    private async Task ResumeSession()
    {
        await GameState.ResumeSessionAsync();
    }

    private async Task FinishSession()
    {
        await GameState.FinishSessionAsync();
    }

    private async Task HandleStructuredSubmit(IReadOnlyDictionary<Guid, AkropolisScoreDetail> details)
    {
        await GameState.SubmitStructuredScoreAndFinishAsync(details);
    }

}
