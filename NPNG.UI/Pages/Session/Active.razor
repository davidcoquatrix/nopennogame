@page "/session"
@using NPNG.Domain.Entities
@using NPNG.Domain.Services
@using NPNG.Domain.Models
@inject NavigationManager NavigationManager
@inject GameStateService GameState
@implements IDisposable

@if (GameState.CurrentSession == null)
{
    <div class="no-session">Aucune session en cours...</div>
}
else if (GameState.CurrentSession.Status == SessionStatus.Finished)
{
    <div class="app-header">
        <div class="header-nav">
            @if (ShowBackButton)
            {
                <BackButton />
            }
            <span class="header-title">@GameState.CurrentSession.Template.Name</span>
        </div>
    </div>

    <GameRecapPanel Session="GameState.CurrentSession" />

    <button class="btn-cta mt-20" @onclick="GoToHome">Retour à l'accueil</button>
    @if (GameState.CurrentSession.Template.ScoreType == ScoreType.Structured)
    {
        <button class="btn-secondary" @onclick="GoToTimeTravel">✎ Modifier le score</button>
    }
    else
    {
        <button class="btn-secondary" @onclick="ResumeSession">Continuer la partie quand même</button>
    }
}
else if (GameState.CurrentSession.Template.ScoreType == ScoreType.Structured)
{
    <div class="app-header">
        <div class="header-nav">
            @if (ShowBackButton)
            {
                <BackButton />
            }
            <span class="header-title">@GameState.CurrentSession.Template.Name</span>
        </div>
    </div>

    <div class="section-label">Feuille de score</div>
    <StructuredScoreSheet
        Definition="StructuredScoringCatalogue.Get(GameState.CurrentSession.Template.StructuredKind!.Value)"
        Players="GameState.CurrentSession.Players"
        ExistingScores="GameState.CurrentSession.Scores"
        OnSubmit="HandleStructuredSubmit" />
}
else
{
    <div class="app-header">
        <div class="header-nav">
            @if (ShowBackButton)
            {
                <BackButton />
            }
            <span class="header-title">@GameState.CurrentSession.Template.Name</span>
        </div>
        <div class="header-actions">
            <span class="header-round-counter">T.@(GameState.CurrentSession.CurrentRound.ToString("D2"))</span>
            <button class="ico-btn tt-btn" title="Time Travel" @onclick="GoToTimeTravel">⏪</button>
            <button class="ico-btn finish-btn" title="Terminer" @onclick="FinishSession">🏁</button>
        </div>
    </div>

    @if (IsPhaseProgression)
    {
        <!-- PROGRESS GRID (classement + saisie, sur le même écran) -->
        <div class="section-label">Progression — Tour @GameState.CurrentSession.CurrentRound</div>
        <PhaseProgressGrid
            Players="GameState.CurrentSession.Players"
            Scores="GameState.CurrentSession.Scores"
            CurrentInputs="currentInputs"
            CurrentPhaseCompleted="currentPhaseCompleted"
            OnPhaseToggled="TogglePhaseCompleted"
            OnScoreChanged="HandleGridScoreChanged" />

        <button class="validate-btn" @onclick="ValidateRound">✓ &nbsp;Valider le
            tour @GameState.CurrentSession.CurrentRound</button>
    }
    else
    {
        <CumulativeScoreBoard
            Players="GameState.CurrentSession.Players"
            Teams="GameState.CurrentSession.Teams"
            Scores="GameState.CurrentSession.Scores"
            IsTeamMode="IsTeamMode"
            Leaderboard="leaderboard"
            TeamLeaderboard="teamLeaderboard"
            HasProgress="HasProgress"
            CurrentRound="GameState.CurrentSession.CurrentRound"
            CurrentInputs="currentInputs"
            CurrentTeamInputs="currentTeamInputs"
            ScoreIncrement="ScoreIncrement"
            FirstPlayerMechanic="GameState.CurrentSession.Template.Rules?.FirstPlayerMechanic ?? FirstPlayerMechanic.None"
            OnScoreChanged="OnScoreChanged"
            OnScoreAdjusted="AdjustScore"
            OnTeamScoreChanged="OnTeamScoreChanged"
            OnTeamScoreAdjusted="AdjustTeamScore"
            OnValidateRound="ValidateRound" />
    }
}

@code {
    private Dictionary<Guid, int> currentInputs = new();
    private List<PlayerScore> leaderboard = new();

    private Dictionary<Guid, int> currentTeamInputs = new();
    private List<TeamScore> teamLeaderboard = new();

    private Dictionary<Guid, bool> currentPhaseCompleted = new();

    private bool IsTeamMode => GameState.CurrentSession?.Players.Any(p => p.TeamId is not null) == true;

    private bool IsPhaseProgression => GameState.CurrentSession?.Template.ScoreType == ScoreType.PhaseProgression;

    private int GetCurrentPhase(Guid playerId) =>
        PhaseProgressCalculator.GetCurrentPhase(playerId, GameState.CurrentSession!.Scores, Phase10Phases.TotalPhases);

    private ScoreIncrementMode ScoreIncrement => GameState.CurrentSession?.Template.Rules?.ScoreIncrement ?? ScoreIncrementMode.OneAndTen;

    // Au tour 1 sans score saisi, tout le monde est à égalité à 0 — "meilleur" n'aurait aucun sens.
    private bool HasProgress => GameState.CurrentSession?.HasProgress == true;

    // Une fois la partie démarrée, il n'y a plus d'écran valide vers lequel revenir
    // (l'écran joueurs se verrouille dès qu'un score existe) — on masque donc le bouton retour.
    private bool ShowBackButton => GameState.CurrentSession != null && !GameState.CurrentSession.HasProgress;

    // Utilisé uniquement pour initialiser currentTeamInputs (UpdateState) ; CumulativeScoreBoard
    // recalcule le même ordre en interne pour son propre rendu, à partir des mêmes Players.
    private IEnumerable<Guid> TeamEntryOrder =>
        GameState.CurrentSession?.Players
            .Where(p => p.TeamId is not null)
            .GroupBy(p => p.TeamId!.Value)
            .OrderBy(g => g.Min(p => p.DisplayOrder))
            .Select(g => g.Key)
        ?? Enumerable.Empty<Guid>();

    protected override async Task OnInitializedAsync()
    {
        GameState.OnStateChanged += HandleStateChanged;

        if (GameState.CurrentSession == null)
        {
            var loaded = await GameState.LoadLatestActiveSessionAsync();
            if (!loaded)
            {
                NavigationManager.NavigateTo("");
                return;
            }
        }

        UpdateState();
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        UpdateState();
        StateHasChanged();
    }

    private void UpdateState()
    {
        if (GameState.CurrentSession != null)
        {
            var playerIds = GameState.CurrentSession.Players.Select(p => p.PlayerId);
            var computedLeaderboard = ScoreCalculator.CalculateLeaderboard(
                GameState.CurrentSession.Template.ScoreType,
                playerIds,
                GameState.CurrentSession.Scores);
            leaderboard = computedLeaderboard.ToList();

            // S'assurer que chaque joueur a une entrée initialisée pour le tour en cours
            foreach (var p in GameState.CurrentSession.Players)
            {
                if (!currentInputs.ContainsKey(p.PlayerId))
                {
                    currentInputs[p.PlayerId] = 0;
                }

                if (!currentPhaseCompleted.ContainsKey(p.PlayerId))
                {
                    currentPhaseCompleted[p.PlayerId] = false;
                }
            }

            if (IsTeamMode)
            {
                teamLeaderboard = ScoreCalculator.GroupIntoTeams(computedLeaderboard, GameState.CurrentSession.Players, GameState.CurrentSession.Teams).ToList();

                // S'assurer que chaque équipe a une entrée initialisée pour le tour en cours
                foreach (var teamId in TeamEntryOrder)
                {
                    if (!currentTeamInputs.ContainsKey(teamId))
                    {
                        currentTeamInputs[teamId] = 0;
                    }
                }
            }
        }
    }

    private void GoToHome()
    {
        NavigationManager.NavigateTo("");
    }

    private void GoToTimeTravel()
    {
        NavigationManager.NavigateTo("session/history");
    }

    private void AdjustScore((Guid PlayerId, int Amount) change)
    {
        if (currentInputs.ContainsKey(change.PlayerId))
        {
            currentInputs[change.PlayerId] += change.Amount;
        }
    }

    private void OnScoreChanged((Guid PlayerId, int Value) change)
    {
        currentInputs[change.PlayerId] = change.Value;
    }

    private void TogglePhaseCompleted(Guid playerId)
    {
        currentPhaseCompleted[playerId] = !currentPhaseCompleted.GetValueOrDefault(playerId);
    }

    private void HandleGridScoreChanged((Guid PlayerId, int Value) change)
    {
        currentInputs[change.PlayerId] = change.Value;
    }

    private void AdjustTeamScore((Guid TeamId, int Amount) change)
    {
        if (currentTeamInputs.ContainsKey(change.TeamId))
        {
            currentTeamInputs[change.TeamId] += change.Amount;
        }
    }

    private void OnTeamScoreChanged((Guid TeamId, int Value) change)
    {
        currentTeamInputs[change.TeamId] = change.Value;
    }

    private async Task ValidateRound()
    {
        if (GameState.CurrentSession == null) return;

        int currentRound = GameState.CurrentSession.CurrentRound;

        if (IsTeamMode)
        {
            foreach (var input in currentTeamInputs)
            {
                await GameState.RecordTeamScoreAsync(input.Key, currentRound, input.Value);
            }

            foreach (var key in currentTeamInputs.Keys.ToList())
            {
                currentTeamInputs[key] = 0;
            }
        }
        else if (IsPhaseProgression)
        {
            // La phase tentée ce tour-ci est capturée avant tout enregistrement, pour ne pas
            // dériver "la phase courante" d'un historique déjà partiellement mis à jour.
            var attemptedPhases = currentInputs.Keys.ToDictionary(playerId => playerId, GetCurrentPhase);

            foreach (var input in currentInputs)
            {
                var phaseDetail = new PhaseScoreDetail(attemptedPhases[input.Key], currentPhaseCompleted.GetValueOrDefault(input.Key));
                await GameState.RecordScoreAsync(input.Key, currentRound, input.Value, phaseDetail);
            }

            foreach (var key in currentInputs.Keys.ToList())
            {
                currentInputs[key] = 0;
                currentPhaseCompleted[key] = false;
            }
        }
        else
        {
            // On enregistre tous les scores saisis
            foreach (var input in currentInputs)
            {
                await GameState.RecordScoreAsync(input.Key, currentRound, input.Value);
            }

            // On remet les compteurs à 0 pour le prochain tour
            foreach (var key in currentInputs.Keys.ToList())
            {
                currentInputs[key] = 0;
            }
        }

        // On passe au tour suivant (ce qui mettra à jour le 1er joueur)
        await GameState.AdvanceToNextRoundAsync();
    }

    private async Task ResumeSession()
    {
        await GameState.ResumeSessionAsync();
    }

    private async Task FinishSession()
    {
        await GameState.FinishSessionAsync();
    }

    private async Task HandleStructuredSubmit(IReadOnlyDictionary<Guid, StructuredScoreDetail> details)
    {
        await GameState.SubmitStructuredScoreAndFinishAsync(details);
    }

}
