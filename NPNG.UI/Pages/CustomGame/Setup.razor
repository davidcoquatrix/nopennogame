@page "/custom-game"
@inject NavigationManager NavigationManager
@inject GameStateService GameState
@inject IGameCatalogueService GameCatalogueService

<div class="app-header">
    <div class="header-nav">
        <BackButton />
        <span style="font-size:1.05rem;font-weight:700">Jeu personnalisé</span>
    </div>
</div>

<div class="form-card">
    <div class="field-lbl">Nom du jeu</div>
    <input class="field-input" type="text" @bind="gameName" placeholder="Ex: Belote maison" />

    <div class="field-lbl">Emoji</div>
    <EmojiPicker Categories="EmojiPalette.GameCategories" @bind-SelectedEmoji="selectedEmoji" />

    <div class="field-lbl">Qui gagne ?</div>
    <div class="toggle-row">
        <button class="toggle-opt @(winCondition == "high" ? "on" : "")" @onclick='() => SetWinCondition("high")'>🏆 Le + haut</button>
        <button class="toggle-opt @(winCondition == "low" ? "on" : "")" @onclick='() => SetWinCondition("low")'>🎯 Le + bas</button>
    </div>

    <div class="setting-row">
        <div class="field-lbl">Passage du 1er joueur</div>
        <input type="checkbox" class="chk" @bind="enableFirstPlayer" />
    </div>

    @if (enableFirstPlayer)
    {
        <div class="toggle-row mechanic-row">
            <button class="toggle-opt @(firstPlayerMechanic == FirstPlayerMechanic.Sequential ? "on" : "")" @onclick='() => SetFirstPlayerMechanic(FirstPlayerMechanic.Sequential)'>🔄 Chacun son tour</button>
            <button class="toggle-opt @(firstPlayerMechanic == FirstPlayerMechanic.Winner ? "on" : "")" @onclick='() => SetFirstPlayerMechanic(FirstPlayerMechanic.Winner)'>🏆 Premier (Général)</button>
            <button class="toggle-opt @(firstPlayerMechanic == FirstPlayerMechanic.Loser ? "on" : "")" @onclick='() => SetFirstPlayerMechanic(FirstPlayerMechanic.Loser)'>🎯 Dernier (Général)</button>
            <button class="toggle-opt @(firstPlayerMechanic == FirstPlayerMechanic.HighestInPreviousRound ? "on" : "")" @onclick='() => SetFirstPlayerMechanic(FirstPlayerMechanic.HighestInPreviousRound)'>📈 + haut (Manche)</button>
            <button class="toggle-opt @(firstPlayerMechanic == FirstPlayerMechanic.LowestInPreviousRound ? "on" : "")" @onclick='() => SetFirstPlayerMechanic(FirstPlayerMechanic.LowestInPreviousRound)'>📉 + bas (Manche)</button>
        </div>
    }

    <div class="input-group-row">
        <div class="input-group-col">
            <div class="field-lbl">Limite de score (opt.)</div>
            <input class="field-input" type="number" @bind="scoreLimit" placeholder="ex : 500" />
        </div>

        <div class="input-group-col">
            <div class="field-lbl">Limite de tours (opt.)</div>
            <input class="field-input" type="number" @bind="roundLimit" placeholder="ex : 10" />
        </div>
    </div>

    <div class="input-group-row">
        <div class="input-group-col">
            <div class="field-lbl">Joueurs min (opt.)</div>
            <input class="field-input" type="number" @bind="minPlayers" placeholder="ex : 2" />
        </div>

        <div class="input-group-col">
            <div class="field-lbl">Joueurs max (opt.)</div>
            <input class="field-input" type="number" @bind="maxPlayers" placeholder="ex : 6" />
        </div>
    </div>

    <div class="setting-row">
        <div class="field-lbl">🤝 Jeu en équipe</div>
        <input type="checkbox" class="chk" @bind="teamsEnabled" />
    </div>

    @if (teamsEnabled)
    {
        <div class="setting-row">
            <div class="field-lbl">Équipes de taille égale obligatoire</div>
            <input type="checkbox" class="chk" @bind="requireEqualTeams" />
        </div>

        @if (requireEqualTeams)
        {
            <div class="input-group-row">
                <div class="input-group-col">
                    <div class="field-lbl">Joueurs par équipe (opt.)</div>
                    <input class="field-input" type="number" @bind="teamSize" placeholder="ex : 2" />
                </div>
            </div>
        }
    }
</div>

<div class="form-card">
    <div class="field-lbl">Incrément par défaut des boutons</div>
    <div class="toggle-row">
        <button class="toggle-opt @(incrementType == ScoreIncrementMode.OneAndTen ? "on" : "")" @onclick="() => SetIncrement(ScoreIncrementMode.OneAndTen)">± 1 / ± 10</button>
        <button class="toggle-opt @(incrementType == ScoreIncrementMode.FiveAndFifty ? "on" : "")" @onclick="() => SetIncrement(ScoreIncrementMode.FiveAndFifty)">± 5 / ± 50</button>
        <button class="toggle-opt @(incrementType == ScoreIncrementMode.Free ? "on" : "")" @onclick="() => SetIncrement(ScoreIncrementMode.Free)">Libre</button>
    </div>
</div>

<div class="save-game-row">
    <input type="checkbox" id="saveGame" @bind="saveToCatalogue" class="chk" />
    <label for="saveGame" class="save-game-lbl">Sauvegarder ce modèle dans mon catalogue</label>
</div>

<div class="info-banner">
    💡 Tu pourras modifier ces règles entre deux parties depuis les paramètres.
</div>

<button class="btn-cta" disabled="@string.IsNullOrWhiteSpace(gameName)" @onclick="CreateGame">
    Créer ce jeu →
</button>

@code {

    private string gameName = "Belote maison";
    private string selectedEmoji = "⚙️";
    private string winCondition = "high";
    private string scoreLimit = "";
    private string roundLimit = "";
    private string minPlayers = "";
    private string maxPlayers = "";
    private ScoreIncrementMode incrementType = ScoreIncrementMode.OneAndTen;
    private bool enableFirstPlayer = true;
    private FirstPlayerMechanic firstPlayerMechanic = FirstPlayerMechanic.Sequential;
    private bool teamsEnabled = false;
    private string teamSize = "";
    private bool requireEqualTeams = true; // Cas général : une partie en équipes se joue à équipes égales

    private bool saveToCatalogue = false;

    [SupplyParameterFromQuery(Name = "baseGameId")]
    public Guid? BaseGameId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (BaseGameId.HasValue)
        {
            var games = await GameCatalogueService.GetAvailableGamesAsync();
            var baseGame = games.FirstOrDefault(g => g.Id == BaseGameId.Value);

            if (baseGame != null)
            {
                gameName = baseGame.Name;
                selectedEmoji = baseGame.Emoji;
                winCondition = baseGame.ScoreType == ScoreType.CumulativeLower ? "low" : "high";
                
                if (baseGame.Rules != null)
                {
                    scoreLimit = baseGame.Rules.TargetScore?.ToString() ?? "";
                    roundLimit = baseGame.Rules.MaxRounds?.ToString() ?? "";
                    minPlayers = baseGame.Rules.MinPlayers?.ToString() ?? "";
                    maxPlayers = baseGame.Rules.MaxPlayers?.ToString() ?? "";
                    firstPlayerMechanic = baseGame.Rules.FirstPlayerMechanic;
                    teamsEnabled = baseGame.Rules.Teams is not null;
                    teamSize = baseGame.Rules.Teams?.TeamSize?.ToString() ?? "";
                    requireEqualTeams = baseGame.Rules.Teams?.RequiresEqualSizes ?? true;
                    incrementType = baseGame.Rules.ScoreIncrement;

                    if (firstPlayerMechanic == FirstPlayerMechanic.None)
                    {
                        enableFirstPlayer = false;
                        firstPlayerMechanic = FirstPlayerMechanic.Sequential; // Keep a default selected if toggled on later
                    }
                }
            }
        }
    }

    private void SetWinCondition(string condition)
    {
        winCondition = condition;
    }

    private void SetFirstPlayerMechanic(FirstPlayerMechanic mechanic)
    {
        firstPlayerMechanic = mechanic;
    }

    private void SetIncrement(ScoreIncrementMode mode)
    {
        incrementType = mode;
    }

    private async Task CreateGame()
    {
        if (string.IsNullOrWhiteSpace(gameName)) return;
        
        var scoreType = winCondition == "high" ? ScoreType.Cumulative : ScoreType.CumulativeLower;
        
        int? parsedScoreLimit = int.TryParse(scoreLimit, out var s) ? s : null;
        int? parsedRoundLimit = int.TryParse(roundLimit, out var r) ? r : null;
        int? parsedMinPlayers = int.TryParse(minPlayers, out var minP) ? minP : null;
        int? parsedMaxPlayers = int.TryParse(maxPlayers, out var maxP) ? maxP : null;
        int? parsedTeamSize = teamsEnabled && requireEqualTeams && int.TryParse(teamSize, out var ts) ? ts : null;
        var teamRules = teamsEnabled ? new TeamRules(parsedTeamSize, requireEqualTeams) : null;

        var finalMechanic = enableFirstPlayer ? firstPlayerMechanic : FirstPlayerMechanic.None;
        var rules = new GameRules(
            TargetScore: parsedScoreLimit,
            MaxRounds: parsedRoundLimit,
            FirstPlayerMechanic: finalMechanic,
            MaxPlayers: parsedMaxPlayers,
            MinPlayers: parsedMinPlayers,
            Teams: teamRules,
            ScoreIncrement: incrementType);

        var template = new GameTemplate(Guid.NewGuid(), gameName.Trim(), scoreType, rules);
        
        if (saveToCatalogue)
        {
            await GameCatalogueService.SaveCustomGameAsync(template, "var(--warn)", selectedEmoji);
        }
        
        await GameState.InitializeNewSessionAsync(template);
        
        NavigationManager.NavigateTo("players");
    }
}
