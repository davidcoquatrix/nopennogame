<div class="score-controls">
    @if (Mode != ScoreIncrementMode.Free)
    {
        <button class="score-button lrg" @onclick="() => Adjust(-LargeStep)">−@LargeStep</button>
        <button class="score-button lrg" @onclick="() => Adjust(-SmallStep)">−@SmallStep</button>
    }
    <NumericCellInput Value="Value" CssClass="@($"score-value {InputClass}")" OnValueChanged="OnValueChanged" />
    @if (Mode != ScoreIncrementMode.Free)
    {
        <button class="score-button slrg" @onclick="() => Adjust(SmallStep)">+@SmallStep</button>
        <button class="score-button slrg" @onclick="() => Adjust(LargeStep)">+@LargeStep</button>
    }
</div>

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> OnScoreAdjusted { get; set; }

    [Parameter]
    public EventCallback<int> OnValueChanged { get; set; }

    [Parameter]
    public string InputClass { get; set; } = "";

    [Parameter]
    public ScoreIncrementMode Mode { get; set; } = ScoreIncrementMode.OneAndTen;

    private int SmallStep => Mode == ScoreIncrementMode.FiveAndFifty ? 5 : 1;
    private int LargeStep => Mode == ScoreIncrementMode.FiveAndFifty ? 50 : 10;

    private async Task Adjust(int amount)
    {
        if (OnScoreAdjusted.HasDelegate)
        {
            await OnScoreAdjusted.InvokeAsync(amount);
        }
    }
}
